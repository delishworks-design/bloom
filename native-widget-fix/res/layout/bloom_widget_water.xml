<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="10dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/waterKicker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:scaleType="fitStart"
            android:layout_weight="1"
            android:contentDescription="Water"/>
        <ImageView
            android:id="@+id/waterCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="0 of 8"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/glassesRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/glass0"
                android:layout_width="20dp"
                android:layout_height="25dp"
                android:src="@drawable/glass_off"
                android:contentDescription="@null"
                android:layout_marginEnd="3dp"/>
            <ImageView
                android:id="@+id/glass1"
                android:layout_width="20dp"
                android:layout_height="25dp"
                android:src="@drawable/glass_off"
                android:contentDescription="@null"
                android:layout_marginEnd="3dp"/>
            <ImageView
                android:id="@+id/glass2"
                android:layout_width="20dp"
                android:layout_height="25dp"
                android:src="@drawable/glass_off"
                android:contentDescription="@null"
                android:layout_marginEnd="3dp"/>
            <ImageView
                android:id="@+id/glass3"
                android:layout_width="20dp"
                android:layout_height="25dp"
                android:src="@drawable/glass_off"
                android:contentDescription="@null"
                android:layout_marginEnd="3dp"/>
            <ImageView
                android:id="@+id/glass4"
                android:layout_width="20dp"
                android:layout_height="25dp"
                android:src="@drawable/glass_off"
                android:contentDescription="@null"
                android:layout_marginEnd="3dp"/>
            <ImageView
                android:id="@+id/glass5"
                android:layout_width="20dp"
                android:layout_height="25dp"
                android:src="@drawable/glass_off"
                android:contentDescription="@null"
                android:layout_marginEnd="3dp"/>
            <ImageView
                android:id="@+id/glass6"
                android:layout_width="20dp"
                android:layout_height="25dp"
                android:src="@drawable/glass_off"
                android:contentDescription="@null"
                android:layout_marginEnd="3dp"/>
            <ImageView
                android:id="@+id/glass7"
                android:layout_width="20dp"
                android:layout_height="25dp"
                android:src="@drawable/glass_off"
                android:contentDescription="@null"
                android:layout_marginEnd="0dp"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/addGlass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Add a glass"/>
    </LinearLayout>
    <ImageView
        android:background="#efe4dc"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="2dp"
        android:contentDescription="@null"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/moodKicker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:scaleType="fitStart"
            android:layout_weight="1"
            android:contentDescription="Mood"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_weight="4"
            android:layout_height="48dp">
            <ImageView
                android:id="@+id/mood1"
                android:padding="5dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:src="@drawable/face_1_off"
                android:contentDescription="Mood 1"
                android:layout_marginStart="2dp"/>
            <ImageView
                android:id="@+id/mood2"
                android:padding="5dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:src="@drawable/face_2_off"
                android:contentDescription="Mood 2"
                android:layout_marginStart="2dp"/>
            <ImageView
                android:id="@+id/mood3"
                android:padding="5dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:src="@drawable/face_3_off"
                android:contentDescription="Mood 3"
                android:layout_marginStart="2dp"/>
            <ImageView
                android:id="@+id/mood4"
                android:padding="5dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:src="@drawable/face_4_off"
                android:contentDescription="Mood 4"
                android:layout_marginStart="2dp"/>
            <ImageView
                android:id="@+id/mood5"
                android:padding="5dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:src="@drawable/face_5_off"
                android:contentDescription="Mood 5"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:background="#efe4dc"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="3dp"
        android:contentDescription="@null"/>
    <ImageView
        android:id="@+id/cycleRow"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitStart"
        android:contentDescription="Cycle phase"/>
</LinearLayout>
